<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:rne="http://www.sat.gob.gt/face2/ComplementoReferenciaNotaEnvio/0.1.0"
    targetNamespace="http://www.sat.gob.gt/face2/ComplementoReferenciaNotaEnvio/0.1.0"
    elementFormDefault="qualified" attributeFormDefault="unqualified">
    <xs:element name="ReferenciasNotaEnvio">
        <xs:annotation>
            <xs:documentation>Agrupa la informacion del documento original al cual hace referencia esta Nota de Envio</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="Version" type="xs:decimal" use="required">
                <xs:annotation>
                    <xs:documentation>Indica la version de este complemento.</xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="NumeroAutorizacionNotadeEnvio">
                <xs:annotation>
                    <xs:documentation>Describe el número de autorización de la nota de envío original, al que se le aplica la referencia que se está emitiendo.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:whiteSpace value="collapse"/>
                        <xs:pattern value="[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}|([2]{1}[0-9]{3}-[1-9]{1}[0-9]{0,2}-[1-9]{1}[0-9]{0,6}-[1-9]{1}[0-9]{0,6})"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="FechaEmisionDocumentoOrigen" type="xs:date">
                <xs:annotation>
                    <xs:documentation>Fecha de emisión del documento al cual se le está aplicando la referencia. </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="SerieDocumentoOrigen">
                <xs:annotation>
                    <xs:documentation>Serie del documento al cual se le emite la referencia.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                        <xs:maxLength value="20"/>
                        <xs:whiteSpace value="collapse"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="NumeroDocumentoOrigen">
                <xs:annotation>
                    <xs:documentation>Número del documento al cual se le emite la referencia.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                        <xs:maxLength value="15"/>
                        <xs:whiteSpace value="collapse"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>